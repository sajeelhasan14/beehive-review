# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Only DATABASE_URL is required. Everything else switches a feature on when present.

# Railway Postgres connection. Server only (no NEXT_PUBLIC_ prefix, so the browser never sees it).
# On your computer: Railway -> Postgres service -> Variables -> copy DATABASE_PUBLIC_URL here.
# When deployed on Railway: set it to ${{Postgres.DATABASE_URL}} (the faster private network address).
DATABASE_URL=postgresql://postgres:password@host.proxy.rlwy.net:12345/railway

# Public address used in QR codes and the copy package, e.g. https://beehive.emrgmedia.com
# Blank = taken from the request (fine on the Railway domain).
PUBLIC_BASE_URL=

# AI smart fill in "+ Add client". Blank = the instant pattern fill is used instead.
ANTHROPIC_API_KEY=

# Google Sheet per client. Paste the service account key JSON (raw or base64). Blank = Sheets off.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Folder (ideally in a Shared Drive the service account belongs to) where sheets are created.
GOOGLE_DRIVE_FOLDER_ID=
# Comma separated emails that get edit access to every new sheet, e.g. ops@emrgmedia.com
GOOGLE_SHEETS_SHARE_WITH=

# "Find them on Google" in Add client (search a business, use its Google review link).
# A Google Maps Platform key with "Places API (New)" enabled. Blank = paste review links by hand.
GOOGLE_MAPS_API_KEY=
